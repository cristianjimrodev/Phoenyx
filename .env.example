# Broker selection: ib or xtb
BROKER=ib

# Interactive Brokers (TWS or IB Gateway must be running)
IB_HOST=127.0.0.1
IB_PORT=7497          # TWS paper=7497, TWS live=7496, Gateway paper=4002, Gateway live=4001
IB_CLIENT_ID=1

# XTB Credentials (if using XTB)
# XTB_USER_ID=your_user_id
# XTB_PASSWORD=your_password
# XTB_MODE=demo
