# .envrc — Phoenyx
#
# Aísla este proyecto del resto de configuraciones de gcloud en esta máquina,
# de modo que NINGÚN `gcloud` ejecutado desde este directorio pueda acabar
# hablando con el proyecto/cuenta equivocados.
#
# Cómo funciona: `CLOUDSDK_ACTIVE_CONFIG_NAME` sobrescribe la configuración
# activa de gcloud a nivel de proceso. Una configuración de gcloud encapsula
# {account, project, region, zone, ...}, por lo que fijarla aquí garantiza
# que la cuenta Google y el proyecto GCP usados son SIEMPRE los de Phoenyx,
# sin depender del estado global (`gcloud config configurations activate`).
#
# ─────────────────────────────────────────────────────────────────────────
# Setup inicial (una sola vez por máquina):
# ─────────────────────────────────────────────────────────────────────────
#
#   # 1. Crear la configuración aislada
#   gcloud config configurations create phoenyx
#
#   # 2. Login con la cuenta Google dedicada (abre navegador)
#   gcloud auth login
#
#   # 3. Fijar cuenta + proyecto + región dentro de esta configuración
#   gcloud config set account <email-dedicado-a-phoenyx>
#   gcloud config set project phoenyx
#   gcloud config set compute/region europe-west1
#   gcloud config set compute/zone   europe-west1-b
#
#   # 4. Application Default Credentials (para las librerías cliente
#   #    que accedan a servicios GCP desde el sistema de trading)
#   gcloud auth application-default login
#
#   # 5. Si usas direnv (recomendado, https://direnv.net):
#   direnv allow
#
#   # Si NO usas direnv, carga este archivo manualmente al abrir terminal:
#   source .envrc
#
# ─────────────────────────────────────────────────────────────────────────
# Verificación rápida de que el aislamiento funciona:
# ─────────────────────────────────────────────────────────────────────────
#
#   gcloud config list            # debe mostrar project=phoenyx, account=<el correcto>
#   gcloud config configurations list   # "phoenyx" debe aparecer como IS_ACTIVE
#
# Si en otra carpeta cambias la config activa con `gcloud config configurations
# activate default`, eso NO afecta a lo que ocurre aquí: al volver a este
# directorio, direnv reinyecta CLOUDSDK_ACTIVE_CONFIG_NAME=phoenyx y gcloud
# vuelve a usar la configuración correcta.
#
# ─────────────────────────────────────────────────────────────────────────

export CLOUDSDK_ACTIVE_CONFIG_NAME=phoenyx
